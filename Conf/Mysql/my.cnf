[client]
socket=/tmp/mysql.sock

[mysqld]
bind-address = 0.0.0.0
binlog_cache_size = 10G
thread_stack = 1G
join_buffer_size = 10G
query_cache_type = 0
max_heap_table_size = 10G
port = 4466
socket = /tmp/mysql.sock
datadir = /home/LTPP/DockerData/Mysql/data
default_storage_engine = InnoDB
performance_schema_max_table_instances = 10240
table_definition_cache = 1024
skip-external-locking = 1
key_buffer_size = 10G
max_allowed_packet = 10G
table_open_cache = 102400000
sort_buffer_size = 10G
net_buffer_length = 10G
read_buffer_size = 10G
read_rnd_buffer_size = 10G
myisam_sort_buffer_size = 10G
thread_cache_size = 1024
query_cache_size = 0K
tmp_table_size = 10G
sql-mode=NO_ENGINE_SUBSTITUTION,STRICT_TRANS_TABLES
default-time-zone = '+08:00'

#skip-name-resolve
max_connections = 100000000
max_connect_errors = 100000000
open_files_limit = 65535

#log-bin=mysql-bin
#binlog_format=mixed
server-id = 1
expire_logs_days = 1
slow_query_log = 1
slow-query-log-file=/home/LTPP/DockerData/Mysql/data/mysql-slow.log
long_query_time = 6
log_queries_not_using_indexes = off

innodb_data_home_dir = /home/LTPP/DockerData/Mysql/data
innodb_data_file_path = ibdata1:10M:autoextend
innodb_log_group_home_dir = /home/LTPP/DockerData/Mysql/data
innodb_buffer_pool_size = 10G
innodb_log_file_size = 10G
innodb_log_buffer_size = 10G
innodb_flush_log_at_trx_commit = 0
innodb_lock_wait_timeout = 60
innodb_max_dirty_pages_pct = 0
innodb_read_io_threads = 16
innodb_write_io_threads = 16

[mysqldump]
quick
max_allowed_packet = 10G

[mysql]
no-auto-rehash

[myisamchk]
key_buffer_size = 10G
sort_buffer_size = 10G
read_buffer = 10G
write_buffer = 10G

[mysqlhotcopy]
interactive-timeout
