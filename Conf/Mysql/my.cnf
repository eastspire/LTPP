[client]
port = 4466
socket=/tmp/mysql.sock

[mysqld]
bind-address = 0.0.0.0
binlog_cache_size = 5120K
thread_stack = 10240K
join_buffer_size = 10240K
query_cache_type = 1
max_heap_table_size = 10240M
port = 4466
socket = /tmp/mysql.sock
datadir = /home/LTPP/DockerData/Mysql/data
default_storage_engine = InnoDB
performance_schema_max_table_instances = 10240
table_definition_cache = 1024
skip-external-locking
key_buffer_size = 10240M
max_allowed_packet = 1G
table_open_cache = 10240
sort_buffer_size = 10240K
net_buffer_length = 1024K
read_buffer_size = 10240K
read_rnd_buffer_size = 5120K
myisam_sort_buffer_size = 5120M
thread_cache_size = 64
query_cache_size = 10240M
tmp_table_size = 5120M
sql-mode=NO_ENGINE_SUBSTITUTION,STRICT_TRANS_TABLES

#skip-name-resolve
max_connections = 10000
max_connect_errors = 1000000
open_files_limit = 65535

#log-bin=mysql-bin
#binlog_format=mixed
server-id = 1
expire_logs_days = 10
slow_query_log=1
slow-query-log-file=/home/LTPP/DockerData/Mysql/data/mysql-slow.log
long_query_time=3
#log_queries_not_using_indexes=on

innodb_data_home_dir = /home/LTPP/DockerData/Mysql/data
innodb_data_file_path = ibdata1:10M:autoextend
innodb_log_group_home_dir = /home/LTPP/DockerData/Mysql/data
innodb_buffer_pool_size = 10240M
innodb_log_file_size = 1024M
innodb_log_buffer_size = 1024M
innodb_flush_log_at_trx_commit = 1
innodb_lock_wait_timeout = 60
innodb_max_dirty_pages_pct = 90
innodb_read_io_threads = 8
innodb_write_io_threads = 8

[mysqldump]
quick
max_allowed_packet = 1G

[mysql]
no-auto-rehash

[myisamchk]
key_buffer_size = 10240M
sort_buffer_size = 10240M
read_buffer = 5120M
write_buffer = 5120M

[mysqlhotcopy]
interactive-timeout
